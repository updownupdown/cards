{
  "name": "cards",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "icons:generate": "node ./scripts/generate-icons.js",
    "assets:generate": "node ./scripts/generate-assets.js",
    "thumbnails:convert": "node ./scripts/convert-thumbnails.mjs",
    "backgrounds:convert": "node ./scripts/convert-backgrounds.mjs",
    "store-graphics:generate": "node ./scripts/generate-store-graphics.mjs",
    "card-backs:generate": "node ./scripts/generate-card-backs.mjs",
    "cards:convert": "node ./scripts/convert-card-decks.mjs",
    "nodes:generate": "node ./scripts/generate-nodes-map.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "i18n": "node ./scripts/i18n.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@sentry/react-native": "~7.11.0",
    "expo": "~55.0.31",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.40",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-keep-awake": "~55.0.8",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-localization": "~55.0.19",
    "expo-navigation-bar": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-store-review": "~55.0.18",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "i18next": "^26.4.2",
    "immer": "^11.1.8",
    "intl-pluralrules": "^2.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.14",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "use-immer": "^0.11.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "@typescript-eslint/parser": "^8.63.0",
    "babel-plugin-require-context-hook": "^1.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-plugin-i18next": "^6.1.5",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "react-native-svg-transformer": "^1.5.3",
    "sharp": "^0.35.4",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "transform": {
      "\\.[jt]sx?$": "<rootDir>/jest/babel-transformer.js"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.svg$": "<rootDir>/jest/svg-stub.js",
      "\\.css$": "<rootDir>/jest/style-stub.js",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm|react-native|@react-native|@react-native-community|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/.*|react-native-svg|immer|use-immer))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "private": true,
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
